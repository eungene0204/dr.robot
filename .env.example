LLM_PROVIDER=exaone
EXAONE_API_KEY=
EXAONE_MODEL=k-exaone_v2.5
# 선택: LLM_PROVIDER=openrouter로 전환할 때만 사용
# 키를 브라우저용 VITE_ 변수에 넣지 마세요.
OPENROUTER_API_KEY=
# JSON schema를 지원하는 모델 ID를 지정하세요.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
PORT=8000

# 기본은 실제 데이터. 시연은 명시적으로 DATA_MODE=demo
DATA_MODE=live
# 선택: 파이프라인 표준 스냅샷 경로 (기본 public/data/catalog.json)
# CATALOG_PATH=/absolute/path/catalog.json
# BUILDMATE_DATA_DIR=/absolute/path/operational-data
# 선택: 네이버 쇼핑 교차 검증 (상품별 naverProductId/Query 매핑 필요)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
