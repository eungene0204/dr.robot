{
  "name": "dr-robot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node backend/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "pipeline": "node pipeline/run.mjs",
    "pipeline:prices": "node pipeline/run.mjs --prices-only",
    "pipeline:benchmarks": "node pipeline/run.mjs --benchmarks-only",
    "pipeline:discover": "node pipeline/discover.mjs",
    "pipeline:schedule": "node pipeline/scheduler.mjs",
    "pipeline:expand": "node pipeline/expand.mjs",
    "pipeline:all": "node pipeline/collect-all.mjs",
    "pipeline:daily": "node --env-file-if-exists=.env pipeline/daily.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "vite": "^6.0.0"
  }
}
